SimulationType           Breakthrough  // [-] Type of simulation (Breakthrough curve)

DisplayName              AC-Zeolite-MOF-Isothermal-Test // [-] Name of the simulation run
Temperature              295           // [K] Temperature of the inlet gas
Ambient_Temperature      295           // [K] Temperature of the surrounding environment
ColumnLength             0.365         // [m] Total length of the adsorption column
BoundaryCoord            0.12        // [m] Coordinate where Layer 0 ends and Layer 1 begins
BoundaryCoord           0.24          // [m] Coordinate where Layer 1 ends and Layer 2 begins  
CarrierGasExist          yes            // If enter yes without "CarrierGas yes" it'll throw an error
Isothermal               no           // MTC = const. or Enter k0 and Ea, no matter Isothermal or not

D_inner                  0.022         // [m] Inner diameter of the column
D_out                    0.026         // [m] Outer diameter of the column (including wall thickness)

// First - Layer 0, Second - Layer 1, Third - Layer 2 ...

// Layer 0 = MOF (e.g., Cu-BTC)
// Layer 1 = Activated Carbon (AC)
// Layer 2 = Zeolite (e.g., 5A or 13X)

ColumnVoidFraction    0.566          // [-] Interstitial void fraction (porosity) of the bed in Layer 0 (MOF)
ColumnVoidFraction       0.3689          // [-] Interstitial void fraction (porosity) of the bed in Layer 1 (AC)
ColumnVoidFraction     0.4152          // [-] Interstitial void fraction (porosity) of the bed in Layer 2 (Zeolite)

ParticleDensity       886.0          // [kg/m^3] Density of the solid adsorbent particles in Layer 0 (MOF)
ParticleDensity          933.2         // [kg/m^3] Density of the solid adsorbent particles in Layer 1 (AC)
ParticleDensity        1329.3         // [kg/m^3] Density of the solid adsorbent particles in Layer 2 (Zeolite)

// --- THERMAL PROPERTIES ---

Cps                    780.0       // [J/(kg*K)] Specific heat capacity of MOF (Layer 0) - Typical: 900-1100
Cps                      850.0         // [J/(kg*K)] Specific heat capacity of AC (Layer 1) - Typical: 800-900
Cps                    920.0         // [J/(kg*K)] Specific heat capacity of Zeolite (Layer 2) - Typical: 900-1050

Lambda_ax             0.20          // [W/(m*K)] Eff. axial thermal conductivity (MOF - typically lower)
Lambda_ax                0.35          // [W/(m*K)] Eff. axial thermal conductivity (AC) - porous bed
Lambda_ax              0.35          // [W/(m*K)] Eff. axial thermal conductivity (Zeolite)

Cpw                      500.0         // [J/(kg*K)] Wall Cp (Steel)
rho_w                    7900.0        // [kg/m^3] Wall density (Steel)
Lambda_w                 16.0          // [W/(m*K)] Wall thermal conductivity (Steel)

// --- HEAT TRANSFER coefficients ---

h_in                     20.0          // [W/(m^2*K)] Heat transfer coeff Gas-Solid/Wall (Layer 0)
h_in                     138.072       // [W/(m^2*K)] Heat transfer coeff Gas-Solid/Wall (Layer 1)
h_in                     75.312        // [W/(m^2*K)] Heat transfer coeff Gas-Solid/Wall (Layer 2)
h_out                    20.0          // [W/(m^2*K)] Heat transfer coeff Wall-Ambient (Natural convection)

TotalPressure            1.50e6        // [Pa] Total absolute pressure at the column inlet
PressureGradient         -5000         // [Pa/m] Linear pressure drop gradient (dP/dz)
ColumnEntranceVelocity   1.2e-2

NumberOfTimeSteps        auto           // [-] Number of time steps (or 'auto' for automatic duration)
PrintEvery               10000          // [-] Interval of steps to print status to console
WriteEvery               100            // [-] Interval of steps to write data to output files
TimeStep                 0.01           // [s] Size of the time step (dt)
NumberOfGridPoints       100            // [-] Number of spatial grid points (discretization nodes)

Component 0 MoleculeName               H2    // [-] Chemical formula/Name
            GasPhaseMolFraction        0.746   // [-] Mole fraction in the feed gas (y_in)
            Cpg                        28.8  // [J/(mol*K)] Molar heat capacity of the gas component
            CarrierGas                 yes   // 
 
